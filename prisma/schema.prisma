datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String // bcrypt hash
  displayName String?
  createdAt   DateTime @default(now())
  projects    Project[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  prompt      String
  code        String   @default("")
  files       String?  // JSON-serialized dist file tree saved from the workbench
  workbenchChatId String? // bolt fork chat urlId, so reloads resume the same chat
  status      String   @default("generating") // generating | completed | failed
  isPublic    Boolean  @default(false)
  viewCount   Int      @default(0)
  tags        String   @default("[]") // JSON string array
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions    Session[]
}

model Session {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String   @default("active") // active | completed | archived
  createdAt DateTime @default(now())
  messages  AgentMessage[]
}

model AgentMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentRole String   // pm | architect | engineer | system | user
  content   String
  type      String   @default("text") // text | plan | code | error
  timestamp DateTime @default(now())
  metadata  String?  // JSON string for agent-specific output
}

model WorkbenchToken {
  id         String    @id @default(uuid())
  token      String    @unique
  projectId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}
